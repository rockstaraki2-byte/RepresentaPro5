{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/generate-offline-service-worker.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test:offline-shell": "node tests/offline-shell.test.mjs",
    "lint": "tsc --noEmit",
    "test:lead-date": "tsx tests/lead-date.test.ts",
    "test:lead-payload": "tsx --test tests/lead-firestore-payload.test.ts",
    "test:order-text-draft": "node --import tsx --test tests/order-text-draft.test.ts",
    "test:firestore-rules": "npx --yes firebase-tools@14.27.0 emulators:exec --project demo-representapro-security --only firestore \"node tests/firestore.rules.test.mjs\"",
    "audit:firestore-tenants": "node scripts/audit-firestore-tenant-readiness.mjs",
    "cleanup:firestore-secrets": "node scripts/cleanup-firestore-sensitive-fields.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^10.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-admin": "^13.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
